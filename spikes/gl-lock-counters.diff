+pub(super) mod lockstat {
+    use std::collections::BTreeMap;
+    use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+    use std::sync::Mutex;
+    pub static TABLE: Mutex<BTreeMap<(&'static str, u32), (u64, u64)>> = Mutex::new(BTreeMap::new());
+    pub static MAKE_CURRENT_NS: AtomicU64 = AtomicU64::new(0);
+    pub static MAKE_CURRENT_N: AtomicU64 = AtomicU64::new(0);
+    pub static BLIT_NS: AtomicU64 = AtomicU64::new(0);
+    pub static SWAP_NS: AtomicU64 = AtomicU64::new(0);
+    pub static PRESENTS: AtomicU64 = AtomicU64::new(0);
+    pub fn presented() {
+        const EVERY: u64 = 200;
+        if PRESENTS.fetch_add(1, Relaxed) + 1 < EVERY {
+            return;
+        }
+        PRESENTS.store(0, Relaxed);
+        let mut table = TABLE.lock().unwrap();
+        let mut rows: alloc::vec::Vec<_> = table.iter().map(|(k, v)| (*k, *v)).collect();
+        rows.sort_by_key(|r| core::cmp::Reverse(r.1 .1));
+        let n = EVERY as f64;
+        let (mut count, mut held) = (0u64, 0u64);
+        for r in &rows {
+            count += r.1 .0;
+            held += r.1 .1;
+        }
+        std::eprintln!(
+            "[locks] per frame: {:.1} locks, {:.2} ms held, make_current {:.1} calls {:.2} ms, blit {:.2} ms, swap {:.2} ms",
+            count as f64 / n,
+            held as f64 / n / 1e6,
+            MAKE_CURRENT_N.swap(0, Relaxed) as f64 / n,
+            MAKE_CURRENT_NS.swap(0, Relaxed) as f64 / n / 1e6,
+            BLIT_NS.swap(0, Relaxed) as f64 / n / 1e6,
+            SWAP_NS.swap(0, Relaxed) as f64 / n / 1e6,
+        );
+        for r in rows.iter().take(14) {
+            std::eprintln!(
+                "[locks]   {:>7.1} per frame {:>7.3} ms  {}:{}",
+                r.1 .0 as f64 / n,
+                r.1 .1 as f64 / n / 1e6,
+                r.0 .0.rsplit('/').next().unwrap_or(r.0 .0),
+                r.0 .1
+            );
+        }
+        table.clear();
+    }
 }
 
