+/// What `queue::PassRun` is told of a render pass, `None` if no other pass can continue it.
+fn pass_targets(
+    desc: &crate::RenderPassDescriptor<super::QuerySet, super::TextureView>,
+) -> Option<super::PassTargets> {
+    let [Some(color)] = desc.color_attachments else {
+        return None;
+    };
+    if desc.sample_count != 1
+        || desc.timestamp_writes.is_some()
+        || desc.occlusion_query_set.is_some()
+        || color.resolve_target.is_some()
+        || color.depth_slice.is_some()
+        || !color.ops.contains(crate::AttachmentOps::STORE)
+        || !matches!(
+            color.target.view.inner,
+            super::TextureInner::Renderbuffer { .. } | super::TextureInner::Texture { .. }
+        )
+    {
+        return None;
+    }
+    let depth = match &desc.depth_stencil_attachment {
+        Some(depth) if depth.target.view.aspects == crate::FormatAspects::DEPTH => Some((
+            depth.target.view.clone(),
+            depth.depth_ops.contains(crate::AttachmentOps::STORE_DISCARD),
+        )),
+        Some(_) => return None,
+        None => None,
+    };
+    Some(super::PassTargets {
+        color: color.target.view.clone(),
+        clears_color: color.ops.contains(crate::AttachmentOps::LOAD_CLEAR),
+        depth,
+    })
+}
