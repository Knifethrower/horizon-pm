+/// Consecutive render passes onto one target, replayed as one GL frame. Each pass takes the
+/// framebuffer apart and puts it together again, and each of wgpu-core's command buffers unbinds
+/// it: on a tile-based GPU that ends the frame, so the whole target is written out and read back
+/// for the next pass, and the driver sets up a frame for each. A pass that loads what the one
+/// before stored needs none of that as long as nothing in between touches the framebuffer.
+#[derive(Default)]
+struct PassRun {
+    /// The pass being replayed, if a following one could continue it.
+    current: Option<alloc::boxed::Box<super::PassTargets>>,
+    /// The pass that has just ended, while nothing else has been replayed since.
+    ended: Option<alloc::boxed::Box<super::PassTargets>>,
+    /// What the passes so far discard, for when the run ends.
+    discard: alloc::vec::Vec<u32>,
+    /// The attachments of a pass that continues the run are in place already.
+    skipping: bool,
+}
+
+fn same_target(a: &super::TextureView, b: &super::TextureView) -> bool {
+    let same = match (&a.inner, &b.inner) {
+        (
+            super::TextureInner::Renderbuffer { raw: a },
+            super::TextureInner::Renderbuffer { raw: b },
+        ) => a == b,
+        (
+            super::TextureInner::Texture { raw: a, target: t },
+            super::TextureInner::Texture { raw: b, target: u },
+        ) => a == b && t == u,
+        _ => false,
+    };
+    same && a.mip_levels == b.mip_levels && a.array_layers == b.array_layers
+}
+
+impl super::PassTargets {
+    /// Whether a pass on `next` can go on where this one left off. Without a depth attachment of
+    /// its own it finds this one's still attached, with the depth test off by its pipelines, so
+    /// that one must be going unread.
+    fn continues_into(&self, next: &Self) -> bool {
+        !next.clears_color
+            && same_target(&self.color, &next.color)
+            && match (&self.depth, &next.depth) {
+                (None, None) => true,
+                (Some((_, discarded)), None) => *discarded,
+                (Some((a, _)), Some((b, _))) => same_target(a, b),
+                (None, Some(_)) => false,
+            }
+    }
+}
+
+impl PassRun {
+    /// Before `command` is replayed: whether it is to be left out.
+    unsafe fn before(&mut self, gl: &glow::Context, can_invalidate: bool, command: &C) -> bool {
+        match command {
+            C::PassTargets(next) => {
+                let continues = match (&self.ended, next) {
+                    (Some(last), Some(next)) => {
+                        last.continues_into(next) && std::env::var_os("HZ_EXP_NO_MERGE").is_none()
+                    }
+                    _ => false,
+                };
+                if continues {
+                    // Its depth is this pass's now, to discard or not at its end.
+                    if next.as_ref().is_some_and(|next| next.depth.is_some()) {
+                        self.discard.clear();
+                    }
+                } else {
+                    unsafe { self.flush(gl, can_invalidate) };
+                }
+                self.ended = None;
+                self.current.clone_from(next);
+                self.skipping = continues;
+                true
+            }
+            C::PassEnd => {
+                self.ended = self.current.take();
+                true
+            }
+            C::ResetFramebuffer { .. } | C::BindAttachment { .. } => self.skipping,
+            C::SetDrawColorBuffers(_) => core::mem::take(&mut self.skipping),
+            C::InvalidateAttachments(list) if self.current.is_some() => {
+                self.discard.extend_from_slice(list);
+                true
+            }
+            C::PushDebugGroup(_)
+            | C::PopDebugGroup
+            | C::InsertDebugMarker(_)
+            | C::UnsetVertexAttribute(_) => false,
+            _ => {
+                if self.ended.take().is_some() {
+                    unsafe { self.flush(gl, can_invalidate) };
+                }
+                false
+            }
+        }
+    }
+    /// The run is over: what it discards, while its framebuffer is still bound.
+    unsafe fn flush(&mut self, gl: &glow::Context, can_invalidate: bool) {
+        if !self.discard.is_empty() && can_invalidate {
+            unsafe { gl.invalidate_framebuffer(glow::DRAW_FRAMEBUFFER, &self.discard) };
+        }
+        self.discard.clear();
+    }
+}
