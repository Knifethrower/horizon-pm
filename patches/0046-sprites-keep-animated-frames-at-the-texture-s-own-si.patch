From 9920b3402237e5f8599a1741b8d5f801f57e6de5 Mon Sep 17 00:00:00 2001
From: Knifethrower <andersenpeters@gmail.com>
Date: Fri, 6 Nov 2026 16:24:23 -0500
Subject: [PATCH 46/54] sprites: keep animated frames at the texture's own size

Hypothesis: every frame of every animated sprite is held at the array's size for the session, 16 times the
pixels of a 16 px texture at a 64 px array: 9.4 MiB for what the texture holds in 0.6 MiB.

Change: SpriteAnimation keeps the native frames it already had. The animator's chains go from those to the
chain's edge directly, and resized_pixels resamples from them.

Number: sprites::resample's live memory, 9.4 MiB to none on an R36S held to 1 GB.

Falsifier: gfx::animate's chain tests fail, or an animated sprite looks different.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/horizon-client-render/src/gfx/animate.rs |  6 ++++--
 crates/horizon-client-render/src/sprites.rs     | 12 ++++--------
 2 files changed, 8 insertions(+), 10 deletions(-)

diff --git a/crates/horizon-client-render/src/gfx/animate.rs b/crates/horizon-client-render/src/gfx/animate.rs
index b269158..f958b39 100644
--- a/crates/horizon-client-render/src/gfx/animate.rs
+++ b/crates/horizon-client-render/src/gfx/animate.rs
@@ -497,7 +497,8 @@ fn source_chains(
         pixels: Vec::with_capacity((edge * edge) as usize * frames.len()),
     };
     for frame in frames {
-        let frame = crate::sprites::resample(frame, size, edge);
+        let side = (frame.len() / 4).isqrt() as u32;
+        let frame = crate::sprites::resample(frame, side, edge);
         sheet.pixels.extend_from_slice(frame.as_chunks::<4>().0);
     }
     let has_transparent = s.has_transparent || sheet.pixels.iter().any(|p| p[3] == 0);
@@ -658,7 +659,8 @@ mod tests {
         assert_eq!(sprites.animations.len(), 9);
         for animation in &sprites.animations {
             for frame in 0..animation.frame_count() {
-                let pixels = animation.pixels(frame);
+                let pixels = animation.resized_pixels(frame, 64, 64);
+                let pixels = &pixels[..];
                 let (expected, _) =
                     super::super::mip_chain(pixels, 64, &sprites.mips, animation.layer, 1);
                 let (chain, edge) = source_chain(pixels, 64, &sprites.mips, animation.layer);
diff --git a/crates/horizon-client-render/src/sprites.rs b/crates/horizon-client-render/src/sprites.rs
index ec1c3d2..83c9441 100644
--- a/crates/horizon-client-render/src/sprites.rs
+++ b/crates/horizon-client-render/src/sprites.rs
@@ -60,6 +60,8 @@ impl SpriteAnimation {
         }
         out
     }
+    /// A frame at the texture's own resolution: the array's size can be many times that, and the
+    /// frames are kept for the whole session.
     pub fn pixels(&self, frame: usize) -> &[u8] {
         &self.frames[frame]
     }
@@ -247,16 +249,10 @@ impl Sprites {
             self.size = size;
             return;
         }
-        let mut resized = Vec::with_capacity(self.native.len());
         self.pixels.clear();
         for (from, frames, initial) in &self.native {
-            let frames: Arc<Vec<Vec<u8>>> =
-                Arc::new(frames.iter().map(|f| resample(f, *from, size)).collect());
-            self.pixels.extend_from_slice(&frames[*initial]);
-            resized.push(frames);
-        }
-        for animation in &mut self.animations {
-            animation.frames = resized[animation.layer as usize].clone();
+            self.pixels
+                .extend_from_slice(&resample(&frames[*initial], *from, size));
         }
         self.size = size;
     }
